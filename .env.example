# Salin menjadi .env lalu sesuaikan
POSTGRES_PASSWORD=ganti-password-ini
PORT=3000

# Batas unggahan
MAX_FILE_MB=100
MAX_TOTAL_MB=300
JOBS_PER_MINUTE=30

# Berapa lama file hasil disimpan sebelum dihapus otomatis
RESULT_TTL_MINUTES=60

# Worker
WORKER_CONCURRENCY=2
JOB_TIMEOUT=300

# HTML ke PDF: 1 = boleh dari URL. HTML_ALLOW_PRIVATE=1 mengizinkan alamat intranet/localhost
# (aktifkan hanya jika server tidak terhubung ke layanan internal yang sensitif)
HTML_URL_ENABLED=1
HTML_ALLOW_PRIVATE=0

# Token untuk GET /api/stats (kosong = nonaktif)
ADMIN_TOKEN=

# ==============================================================================
# Integrasi SSO E-Portal UIKA (Sistem hanya dapat diakses melalui E-Portal)
# ==============================================================================
# Aktifkan perlindungan SSO (1 = aktif, 0 = nonaktif untuk dev offline)
SSO_ENABLED=1

# URL Base API E-Portal untuk introspeksi token
# Produksi: https://eportal.uika-bogor.ac.id/eportal-api/api
# Lokal dev: http://localhost:8000/api
SSO_BASE_URL=https://eportal.uika-bogor.ac.id/eportal-api/api

# Pemetaan domain E-Portal ke IP lokal untuk melewati firewall kampus
SSO_HOST_MAP=eportal.uika-bogor.ac.id:172.16.18.141

# Izinkan sertifikat internal untuk koneksi lokal antar-server
NODE_TLS_REJECT_UNAUTHORIZED=0

# URL Frontend E-Portal (tujuan redirect user jika belum login)
# Produksi: https://eportal.uika-bogor.ac.id
# Lokal dev: http://localhost:5173
EPORTAL_URL=https://eportal.uika-bogor.ac.id

# Kredensial SSO Client yang didapat dari tabel sso_clients / pembuatan modul di E-Portal Admin
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_APP_MODULE_ID=

# Kunci rahasia untuk menandatangani cookie sesi lokal (acak & amankan untuk produksi)
SESSION_SECRET=ganti-dengan-kunci-rahasia-acak-minimal-32-karakter
SESSION_TTL_HOURS=12
